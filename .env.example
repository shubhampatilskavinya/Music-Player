# Vercel: connect an Upstash Redis database, then add BOTH variables server-side.
# Never prefix these with NEXT_PUBLIC_. Do not commit real tokens.
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-write-capable-rest-token"
# Optional stable session name; use different keys/databases for preview and production.
# MIRC_SESSION_KEY=mirc:music:production
# Local-only disk directory, when Redis is not configured:
# MIRC_DATA_DIR=/absolute/path/to/data

# Host/guest login. Never prefix these with NEXT_PUBLIC_. Do not commit real values.
MIRC_HOST_PIN="your-host-pin"
MIRC_SESSION_SECRET="a-long-random-string-used-to-sign-login-cookies"
MIRC_PARTY_CODE="MIRC-7"
